# ==============================================================================
# Memo - 環境變數設定範本 (.env.example)
# ==============================================================================
# 💡 貼心提示：Memo 已經內建「網頁版設定精靈」，啟動後直接在網頁填入即可！
# 若您習慣使用環境變數，可將此檔案複製為 .env.local 並填入設定：
# ==============================================================================

# Google Gemini API 金鑰（必填，開箱啟用 AI 卡片解析、食譜換算與問答）
# 免費申請網址（30 秒免信用卡）：https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourApiKeyHere

# 預設使用的 Gemini 模型 (建議使用最新高額度的 gemini-3.5-flash-lite 或 gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# 對外公開網址（選填，若有自訂網域或 Cloudflare Tunnel 可填寫，例如 https://memo.yourdomain.com/memo）
# NEXT_PUBLIC_SITE_URL=http://localhost:3000/memo

# 服務監聽連接埠 (預設 3000)
PORT=3000
